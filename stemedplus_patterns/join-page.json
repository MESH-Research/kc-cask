  "title": "Join Page",
  "content": "<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"right\":\"var:preset|spacing|30\",\"left\":\"var:preset|spacing|30\"}}}} -->\n<p style=\"padding-right:var(--wp--preset--spacing--30);padding-left:var(--wp--preset--spacing--30)\">Joining this SITE is a two-step process. </p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"right\":\"var:preset|spacing|30\",\"left\":\"var:preset|spacing|30\"}},\"elements\":{\"link\":{\"color\":{\"text\":\"#3209ea\"},\":hover\":{\"color\":{\"text\":\"#6e1d1d\"}}}}}} -->\n<p class=\"has-link-color\" style=\"padding-right:var(--wp--preset--spacing--30);padding-left:var(--wp--preset--spacing--30)\">First, you will join <a href=\"https://stemedplus.org/\">STEMEd+ Commons</a>, the cyber-infrastructure housing our community. Second, you will join SITE to join discussions, register for events, and deposit to our digital collection.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:buttons {\"style\":{\"spacing\":{\"padding\":{\"right\":\"var:preset|spacing|30\",\"left\":\"var:preset|spacing|30\"}}},\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-buttons\" style=\"padding-right:var(--wp--preset--spacing--30);padding-left:var(--wp--preset--spacing--30)\"><!-- wp:button {\"style\":{\"color\":{\"background\":\"#993319\"},\"typography\":{\"fontSize\":\"1.42rem\"},\"spacing\":{\"padding\":{\"left\":\"var:preset|spacing|50\",\"right\":\"var:preset|spacing|50\",\"top\":\"var:preset|spacing|30\",\"bottom\":\"var:preset|spacing|30\"}},\"shadow\":\"var:preset|shadow|natural\"}} -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link has-background has-custom-font-size wp-element-button\" href=\"https://stemedplus.org/join-stemed/\" style=\"background-color:#993319;padding-top:var(--wp--preset--spacing--30);padding-right:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--30);padding-left:var(--wp--preset--spacing--50);box-shadow:var(--wp--preset--shadow--natural);font-size:1.42rem\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Join STEMEd+ Commons</strong></a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:buttons {\"style\":{\"spacing\":{\"padding\":{\"right\":\"var:preset|spacing|30\",\"left\":\"var:preset|spacing|30\"}}},\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-buttons\" style=\"padding-right:var(--wp--preset--spacing--30);padding-left:var(--wp--preset--spacing--30)\"><!-- wp:button {\"style\":{\"color\":{\"background\":\"#993319\"},\"typography\":{\"fontSize\":\"1.42rem\"},\"spacing\":{\"padding\":{\"left\":\"var:preset|spacing|50\",\"right\":\"var:preset|spacing|50\",\"top\":\"var:preset|spacing|30\",\"bottom\":\"var:preset|spacing|30\"}},\"shadow\":\"var:preset|shadow|natural\"}} -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link has-background has-custom-font-size wp-element-button\" style=\"background-color:#993319;padding-top:var(--wp--preset--spacing--30);padding-right:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--30);padding-left:var(--wp--preset--spacing--50);box-shadow:var(--wp--preset--shadow--natural);font-size:1.42rem\"><strong>Join SITE (add link to your primary group)</strong></a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"right\":\"var:preset|spacing|30\",\"left\":\"var:preset|spacing|30\"}}}} -->\n<p style=\"padding-right:var(--wp--preset--spacing--30);padding-left:var(--wp--preset--spacing--30)\">Click <strong>Join STEMEd+ Commons</strong> to open a new window - follow the instructions and then return here!</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:paragraph -->\n<p>Click <strong>Join SITE! </strong>You need to be logged into STEMEd+ Commons in order to see the JOIN button.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->",
  "syncStatus": "unsynced"
}
