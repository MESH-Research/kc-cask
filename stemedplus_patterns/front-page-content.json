  "title": "TemplateFrontPageContent",
  "content": "<!-- wp:columns {\"style\":{\"spacing\":{\"padding\":{\"right\":\"var:preset|spacing|30\",\"left\":\"var:preset|spacing|30\"}}}} -->\n<div class=\"wp-block-columns\" style=\"padding-right:var(--wp--preset--spacing--30);padding-left:var(--wp--preset--spacing--30)\"><!-- wp:column {\"width\":\"33.33%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:33.33%\"><!-- wp:image {\"id\":19,\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-full\"><img src=\"https://hcommons.org/app/uploads/sites/1005536/2026/09/ReplaceWithSiteLogo_STEMEd.png\" alt=\"\" class=\"wp-image-19\"/></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"verticalAlignment\":\"center\",\"width\":\"66.66%\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\" style=\"flex-basis:66.66%\"><!-- wp:paragraph {\"style\":{\"typography\":{\"fontStyle\":\"normal\",\"fontWeight\":\"600\"}},\"fontSize\":\"x-large\"} -->\n<p class=\"has-x-large-font-size\" style=\"font-style:normal;font-weight:600\">Welcome to SITE!</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>The SITE is BRIEF DESCRIPTION.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:spacer {\"height\":\"22px\"} -->\n<div style=\"height:22px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:columns {\"style\":{\"spacing\":{\"padding\":{\"right\":\"var:preset|spacing|30\",\"left\":\"var:preset|spacing|30\"}}}} -->\n<div class=\"wp-block-columns\" style=\"padding-right:var(--wp--preset--spacing--30);padding-left:var(--wp--preset--spacing--30)\"><!-- wp:column {\"width\":\"33.33%\",\"style\":{\"border\":{\"width\":\"2px\"},\"spacing\":{\"padding\":{\"right\":\"var:preset|spacing|20\",\"left\":\"var:preset|spacing|20\",\"top\":\"var:preset|spacing|20\",\"bottom\":\"var:preset|spacing|20\"}}},\"borderColor\":\"accent-2\"} -->\n<div class=\"wp-block-column has-border-color has-accent-2-border-color\" style=\"border-width:2px;padding-top:var(--wp--preset--spacing--20);padding-right:var(--wp--preset--spacing--20);padding-bottom:var(--wp--preset--spacing--20);padding-left:var(--wp--preset--spacing--20);flex-basis:33.33%\"><!-- wp:paragraph {\"style\":{\"typography\":{\"fontStyle\":\"normal\",\"fontWeight\":\"600\"}},\"fontSize\":\"medium\"} -->\n<p class=\"has-medium-font-size\" style=\"font-style:normal;font-weight:600\">In this box, you can add images, RSS feed, another page, links to videos, or whatever interests you. </p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"verticalAlignment\":\"center\",\"width\":\"66.66%\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\" style=\"flex-basis:66.66%\"><!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"width\":75,\"style\":{\"color\":{\"background\":\"#af4235\"},\"typography\":{\"fontSize\":\"1.6rem\"}}} -->\n<div class=\"wp-block-button has-custom-width wp-block-button__width-75\"><a class=\"wp-block-button__link has-background has-custom-font-size wp-element-button\" style=\"background-color:#af4235;font-size:1.6rem\"><strong>Join the SITE</strong> (this page is included)</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"right\":\"var:preset|spacing|30\",\"left\":\"var:preset|spacing|30\"}}}} -->\n<p style=\"padding-right:var(--wp--preset--spacing--30);padding-left:var(--wp--preset--spacing--30)\">For buttons below - delete any buttons you do not want. For remaining buttons, add links to images - users will be able to click and go.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:group {\"style\":{\"spacing\":{\"margin\":{\"top\":\"var:preset|spacing|40\",\"bottom\":\"var:preset|spacing|40\"},\"blockGap\":\"2px\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group\" style=\"margin-top:var(--wp--preset--spacing--40);margin-bottom:var(--wp--preset--spacing--40)\"><!-- wp:image {\"id\":1795,\"width\":\"157px\",\"height\":\"auto\",\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"align\":\"center\"} -->\n<figure class=\"wp-block-image aligncenter size-full is-resized\"><img src=\"https://hcommons.org/app/uploads/sites/1005386/2026/07/STEMEd-Dreams-2026-60.png\" alt=\"\" class=\"wp-image-1795\" style=\"width:157px;height:auto\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":4,\"style\":{\"typography\":{\"textAlign\":\"center\",\"fontSize\":\"1.38em\"}}} -->\n<h4 class=\"wp-block-heading has-text-align-center\" style=\"font-size:1.38em\"><strong>SITE MEMBERS</strong></h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0\",\"bottom\":\"0\"}},\"typography\":{\"textAlign\":\"center\"}}} -->\n<p class=\"has-text-align-center\" style=\"padding-top:0;padding-bottom:0\">Connect with other members</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:group {\"style\":{\"spacing\":{\"margin\":{\"top\":\"var:preset|spacing|40\",\"bottom\":\"var:preset|spacing|40\"},\"blockGap\":\"2px\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group\" style=\"margin-top:var(--wp--preset--spacing--40);margin-bottom:var(--wp--preset--spacing--40)\"><!-- wp:image {\"lightbox\":{\"enabled\":false},\"id\":1797,\"width\":\"157px\",\"height\":\"auto\",\"sizeSlug\":\"full\",\"linkDestination\":\"custom\",\"align\":\"center\"} -->\n<figure class=\"wp-block-image aligncenter size-full is-resized\"><a href=\"https://stemedplus.org/stemed-groups/dber-alliance-primary-discussion-listserv/events/\"><img src=\"https://hcommons.org/app/uploads/sites/1005386/2026/07/STEMEd-Dreams-2026-61.png\" alt=\"\" class=\"wp-image-1797\" style=\"width:157px;height:auto\"/></a></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":4,\"style\":{\"typography\":{\"textAlign\":\"center\",\"fontSize\":\"1.38em\"}}} -->\n<h4 class=\"wp-block-heading has-text-align-center\" style=\"font-size:1.38em\"><strong>SITE EVENTS</strong></h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0\",\"bottom\":\"0\"}},\"typography\":{\"textAlign\":\"center\"}}} -->\n<p class=\"has-text-align-center\" style=\"padding-top:0;padding-bottom:0\">View upcoming events</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:group {\"style\":{\"spacing\":{\"margin\":{\"top\":\"var:preset|spacing|40\",\"bottom\":\"var:preset|spacing|40\"},\"blockGap\":\"2px\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group\" style=\"margin-top:var(--wp--preset--spacing--40);margin-bottom:var(--wp--preset--spacing--40)\"><!-- wp:image {\"lightbox\":{\"enabled\":false},\"id\":1798,\"width\":\"157px\",\"height\":\"auto\",\"sizeSlug\":\"full\",\"linkDestination\":\"custom\",\"align\":\"center\"} -->\n<figure class=\"wp-block-image aligncenter size-full is-resized\"><a href=\"https://stemedplus.org/stemed-groups/dber-alliance-primary-discussion-listserv/forum/\"><img src=\"https://hcommons.org/app/uploads/sites/1005386/2026/07/STEMEd-Dreams-2026-62.png\" alt=\"\" class=\"wp-image-1798\" style=\"width:157px;height:auto\"/></a></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":4,\"style\":{\"typography\":{\"textAlign\":\"center\",\"fontSize\":\"1.38em\"}}} -->\n<h4 class=\"wp-block-heading has-text-align-center\" style=\"font-size:1.38em\"><strong>SITE DISCUSSION FORUM</strong></h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0\",\"bottom\":\"0\"}},\"typography\":{\"textAlign\":\"center\"}}} -->\n<p class=\"has-text-align-center\" style=\"padding-top:0;padding-bottom:0\">Join conversations</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:group {\"style\":{\"spacing\":{\"margin\":{\"top\":\"var:preset|spacing|40\",\"bottom\":\"var:preset|spacing|40\"},\"blockGap\":\"2px\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group\" style=\"margin-top:var(--wp--preset--spacing--40);margin-bottom:var(--wp--preset--spacing--40)\"><!-- wp:image {\"lightbox\":{\"enabled\":false},\"id\":1799,\"width\":\"157px\",\"height\":\"auto\",\"sizeSlug\":\"full\",\"linkDestination\":\"custom\",\"align\":\"center\"} -->\n<figure class=\"wp-block-image aligncenter size-full is-resized\"><a href=\"https://works.hcommons.org/collections/dber-alliance-primary-discussion-listserv/records?q=&amp;l=list&amp;p=1&amp;s=10&amp;sort=newest\" target=\"_blank\" rel=\" noreferrer noopener\"><img src=\"https://hcommons.org/app/uploads/sites/1005386/2026/07/STEMEd-Dreams-2026-63.png\" alt=\"\" class=\"wp-image-1799\" style=\"width:157px;height:auto\"/></a></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":4,\"style\":{\"typography\":{\"textAlign\":\"center\",\"fontSize\":\"1.38em\"}}} -->\n<h4 class=\"wp-block-heading has-text-align-center\" style=\"font-size:1.38em\"><strong>SITE COLLECTION</strong></h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0\",\"bottom\":\"0\"}},\"typography\":{\"textAlign\":\"center\"}}} -->\n<p class=\"has-text-align-center\" style=\"padding-top:0;padding-bottom:0\">Share openly </p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0\",\"bottom\":\"0\"}},\"typography\":{\"textAlign\":\"center\"}}} -->\n<p class=\"has-text-align-center\" style=\"padding-top:0;padding-bottom:0\">Generate DOIs</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:group {\"style\":{\"spacing\":{\"margin\":{\"top\":\"var:preset|spacing|40\",\"bottom\":\"var:preset|spacing|40\"},\"blockGap\":\"2px\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group\" style=\"margin-top:var(--wp--preset--spacing--40);margin-bottom:var(--wp--preset--spacing--40)\"><!-- wp:image {\"lightbox\":{\"enabled\":false},\"id\":19,\"width\":\"157px\",\"height\":\"auto\",\"sizeSlug\":\"full\",\"linkDestination\":\"custom\",\"align\":\"center\"} -->\n<figure class=\"wp-block-image aligncenter size-full is-resized\"><img src=\"https://hcommons.org/app/uploads/sites/1005536/2026/09/ReplaceWithSiteLogo_STEMEd.png\" alt=\"\" class=\"wp-image-19\" style=\"width:157px;height:auto\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":4,\"style\":{\"typography\":{\"textAlign\":\"center\",\"fontSize\":\"1.38em\"}}} -->\n<h4 class=\"wp-block-heading has-text-align-center\" style=\"font-size:1.38em\"><strong>SITE AFFILIATES</strong></h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0\",\"bottom\":\"0\"}},\"typography\":{\"textAlign\":\"center\"}}} -->\n<p class=\"has-text-align-center\" style=\"padding-top:0;padding-bottom:0\">Connect and learn</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->",
